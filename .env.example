# GEMINI_API_KEY: Required for server-side Gemini image generation (/api/generate-art).
# Add this in Vercel -> Project Settings -> Environment Variables when deploying from GitHub.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: Production site URL for OpenGraph / Twitter metadata on Vercel
# NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
APP_URL="http://localhost:3000"
